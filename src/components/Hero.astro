---
import { hero, whatsappLink } from '../data/content';

const heroImage = `${import.meta.env.BASE_URL}hero-lagoa.jpg`;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="hero-content reveal">
      <p class="section-label">{hero.eyebrow}</p>
      <h1 id="hero-heading" class="hero-heading">
        <span class="hero-title-lead">{hero.title.lead}</span>
        <span class="hero-title-place">{hero.title.place}</span>
        <span class="hero-title-region">{hero.title.region}</span>
      </h1>
      <p class="hero-tagline">{hero.tagline}</p>
      <p class="hero-sub">{hero.subheadline}</p>
      <p class="hero-note">{hero.note}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={whatsappLink()} rel="noopener noreferrer" target="_blank">
          Falar no WhatsApp
        </a>
        <a class="btn btn-ghost" href="#servicos">Ver serviços</a>
      </div>
    </div>
    <figure class="hero-visual reveal">
      <img
        src={heroImage}
        alt="Vista da Lagoa da Conceição em Florianópolis, Santa Catarina"
        width="1280"
        height="845"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="hero-visual-caption">
        <span>Lagoa da Conceição · Florianópolis, SC</span>
        <span class="hero-photo-credit">
          Foto: <a href="https://commons.wikimedia.org/wiki/File:Lagoa_da_Concei%C3%A7%C3%A3o.jpg" rel="license noopener noreferrer" target="_blank">Renato M.E. Sabbatini</a> · CC BY-SA 2.5
        </span>
      </figcaption>
    </figure>
  </div>
</section>
