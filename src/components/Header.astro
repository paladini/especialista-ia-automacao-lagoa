---
import { site, navLinks, whatsappLink } from '../data/content';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={import.meta.env.BASE_URL}>{site.brand}</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menu">
      <span aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Principal">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
        <li class="nav-mobile-cta">
          <a class="btn btn-primary" href={whatsappLink()} rel="noopener noreferrer" target="_blank">
            WhatsApp
          </a>
        </li>
      </ul>
    </nav>
    <a class="btn btn-primary header-cta" href={whatsappLink()} rel="noopener noreferrer" target="_blank">
      WhatsApp
    </a>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('#site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    });
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menu');
      });
    });
  }
</script>
